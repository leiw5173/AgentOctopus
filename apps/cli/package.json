    "@agentoctopus/skills": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ora": "^9.4.0",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "inquirer": "^14.0.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
