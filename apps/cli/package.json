{
  "name": "@agentoctopus/cli",
  "version": "0.9.0",
  "description": "AgentOctopus CLI — route natural language queries to skills via `octopus ask`",
  "type": "module",
  "bin": {
    "octopus": "./dist/index.js"
  },
  "files": [
    "README.md",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentoctopus/core": "workspace:*",
