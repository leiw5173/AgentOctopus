{
  "name": "@agentoctopus/sandbox",
  "version": "0.9.0",
  "description": "AgentOctopus sandbox isolation: policy, immutable snapshots, secret provider, egress proxy, backends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "security:images": "node scripts/build-security-images.mjs",
    "security:probe-linux": "node scripts/security-probe-linux.mjs",
    "security:cleanup-linux": "node scripts/security-cleanup-linux.mjs",
    "security:probe-darwin": "node scripts/darwin-sbpl-feasibility.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "node-forge": "^1.3.1",
    "tldts": "^7.0.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/node-forge": "^1.3.11",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
