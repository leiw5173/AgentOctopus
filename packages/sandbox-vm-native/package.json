{
  "name": "@agentoctopus/sandbox-vm-native",
  "version": "0.1.0",
  "description": "Native VM sandbox backend: libkrun helper, ext4 image-builder, guest bootstrap",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "prebuilds"
  ],
  "scripts": {
    "build": "tsc",
    "build:helper": "node scripts/build-vm-helper.mjs",
    "security:build-vm": "node scripts/vendor-libkrun.mjs && node scripts/build-vm-helper.mjs && node scripts/build-vm-rootfs.mjs",
    "security:probe-vm": "node scripts/run-vm-gates.mjs --step gate",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentoctopus/sandbox": "workspace:^",
    "koffi": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
