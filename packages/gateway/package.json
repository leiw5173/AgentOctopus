{
  "name": "@agentoctopus/gateway",
  "version": "0.8.0",
  "description": "AgentOctopus gateways: Slack, Discord, Telegram bots and agent-to-agent HTTP protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "agentoctopus-gateway": "./dist/bin/start-agent-gateway.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:agent": "tsx src/bin/start-agent-gateway.ts",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentoctopus/adapters": "workspace:*",
    "@agentoctopus/core": "workspace:*",
    "@agentoctopus/registry": "workspace:*",
    "@slack/bolt": "^4.7.3",
    "discord.js": "^14.15.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.6.0",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/leiw5173/AgentOctopus"
  },
  "keywords": [
    "ai",
    "agent",
    "slack",
    "discord",
    "telegram",
    "bot",
    "mcp",
    "gateway"
  ]
}
